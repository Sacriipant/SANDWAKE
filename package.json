{
  "name": "sandwake",
  "version": "1.0.0",
  "description": "SandWake: glide a woven carpet over procedural sand dunes. A lightweight 3D browser game with an Amazigh art direction.",
  "keywords": [
    "game",
    "webgl",
    "threejs",
    "procedural",
    "amazigh"
  ],
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=300000 tests/e2e/*.e2e.js",
    "lint": "eslint . && node scripts/lint-bundle.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "three": "0.128.0"
  }
}
